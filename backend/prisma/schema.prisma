generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  name          String
  phone         String?
  role          String
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  fisher        Fisher?
  buyer         Buyer?
  notifications Notification[]
  alerts        Alert[]
  auditLogs     AuditLog[]
}

model Fisher {
  id               String          @id @default(uuid())
  userId           String          @unique
  fisherId         String          @unique
  licenseNumber    String?
  fishingRegion    String?
  trustScore       Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenses         License[]
  catchBatches     CatchBatch[]
  listings         Listing[]
  orders           Order[]
  violations       Violation[]
}

model Buyer {
  id               String          @id @default(uuid())
  userId           String          @unique
  businessName     String?
  createdAt        DateTime        @default(now())

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           Order[]
}

model License {
  id             String   @id @default(uuid())
  fisherId       String
  number         String   @unique
  status         String   @default("PENDING")
  issuedAt       DateTime?
  expiresAt      DateTime?
  region         String?
  createdAt      DateTime @default(now())

  fisher         Fisher   @relation(fields: [fisherId], references: [id], onDelete: Cascade)
}

model Species {
  id                String    @id @default(uuid())
  scientificName    String?
  commonName        String
  regionalName      String?
  category          String?
  conservationStatus String?
  defaultQuota      Float?
  minimumLegalSize  Float?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  catchBatches      CatchBatch[]
  quotas            Quota[]
  listings          Listing[]
}

model Season {
  id          String   @id @default(uuid())
  name        String
  year        Int
  startDate   DateTime
  endDate     DateTime
  active      Boolean  @default(true)

  quotas      Quota[]
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("ACTIVE")
  restrictions    String?
  allowedSpecies  String?
  polygon         String?
  createdAt       DateTime @default(now())

  quotas      Quota[]
}

model Quota {
  id             String   @id @default(uuid())
  speciesId      String
  seasonId       String
  zoneId         String?
  totalQuota     Float
  consumed       Float    @default(0)
  createdAt      DateTime @default(now())

  species        Species  @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  zone           Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
}

model CatchBatch {
  id                     String             @id @default(uuid())
  fisherId               String
  speciesId              String
  quantity               Float
  unit                   String
  catchDate              DateTime
  locationLat            Float?
  locationLng            Float?
  fishingZone            String?
  notes                  String?
  status                 String             @default("PENDING")
  trustScore             Int                @default(0)
  trustStatus            String             @default("REVIEW")
  qrCodeToken            String             @unique
  syncStatus             String             @default("SYNCED")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  fisher                 Fisher             @relation(fields: [fisherId], references: [id], onDelete: Cascade)
  species                Species            @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  trustRuleResults       TrustRuleResult[]
  traceabilityEvents     TraceabilityEvent[]
  listings              Listing[]
  violations             Violation[]
  alerts                Alert[]
}

model TrustRuleResult {
  id          String   @id @default(uuid())
  catchId     String
  rule        String
  contribution Int
  status      String
  explanation String
  createdAt   DateTime @default(now())

  catchBatch  CatchBatch @relation(fields: [catchId], references: [id], onDelete: Cascade)
}

model TraceabilityEvent {
  id             String   @id @default(uuid())
  catchId        String
  eventType      String
  description    String
  previousHash   String?
  eventHash      String
  createdAt      DateTime @default(now())

  catchBatch     CatchBatch @relation(fields: [catchId], references: [id], onDelete: Cascade)
}

model Listing {
  id              String        @id @default(uuid())
  fisherId        String
  speciesId       String
  catchId         String?
  title           String
  description     String?
  quantity        Float
  pricePerKg      Float
  freshness       String
  region          String?
  status          String        @default("ACTIVE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  fisher          Fisher        @relation(fields: [fisherId], references: [id], onDelete: Cascade)
  species         Species       @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  catchBatch      CatchBatch?   @relation(fields: [catchId], references: [id], onDelete: SetNull)
  orders          OrderItem[]
}

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  fisherId        String?
  status          String      @default("PENDING")
  totalAmount     Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyer           Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  fisher          Fisher?     @relation(fields: [fisherId], references: [id], onDelete: SetNull)
  items           OrderItem[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  listingId   String
  quantity    Float
  pricePerKg  Float
  subtotal    Float
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id          String   @id @default(uuid())
  species      String
  region       String
  pricePerKg   Float
  date         DateTime
  createdAt    DateTime @default(now())
}

model WeatherRecord {
  id          String   @id @default(uuid())
  location    String
  temperature Float?
  windSpeed   Float?
  rain        Float?
  condition   String?
  timestamp   DateTime
  createdAt   DateTime @default(now())
}

model Alert {
  id          String        @id @default(uuid())
  userId      String?
  catchId     String?
  category    String
  severity    String
  title       String
  message     String
  read        Boolean       @default(false)
  createdAt   DateTime      @default(now())

  catchBatch  CatchBatch?   @relation(fields: [catchId], references: [id], onDelete: SetNull)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Violation {
  id          String          @id @default(uuid())
  fisherId    String
  catchId     String?
  type        String
  severity    String          @default("WARNING")
  status      String          @default("OPEN")
  description String
  createdAt   DateTime        @default(now())

  fisher      Fisher          @relation(fields: [fisherId], references: [id], onDelete: Cascade)
  catchBatch  CatchBatch?     @relation(fields: [catchId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  timestamp  DateTime @default(now())
  metadata   String?

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ZonePressure {
  id          String   @id @default(uuid())
  zoneName    String
  speciesName String
  pressure    Float
  status      String
  period      String
  createdAt   DateTime @default(now())
}
